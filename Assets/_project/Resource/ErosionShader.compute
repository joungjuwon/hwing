#pragma kernel CSMain

struct HeightData {
    float height;
};

RWStructuredBuffer<HeightData> heightBuffer;
RWStructuredBuffer<float> maskBuffer;

int mapSize;
float rTime;

float random(float2 st) {
    return frac(sin(dot(st.xy, float2(12.9898, 78.233))) * 43758.5453123);
}

[numthreads(1, 1, 1)]
void CSMain (uint3 id : SV_DispatchThreadID) {
    float2 seed = float2((float)id.x + rTime, rTime * 0.5f);
    float posX = random(seed) * (float)(mapSize - 1);
    float posY = random(seed + 0.123f) * (float)(mapSize - 1);

    float sediment = 0.0f;
    
    // [수정됨] 값들을 절반으로 줄임
    float baseCapacity = 0.05f;    // 0.1 -> 0.05 (한 번에 파내는 흙의 양/구멍 크기 감소)
    float baseErodeSpeed = 0.025f; // 0.05 -> 0.025 (깎이는 속도 감소)
    float globalMinHeight = -1.0f; // -2.0 -> -1.0 (최대 깊이 얕아짐)
    
    float depositSpeed = 0.02f;

    for (int i = 0; i < 30; i++) {
        int x = (int)posX;
        int y = (int)posY;
        int index = y * mapSize + x;

        if (x < 1 || x >= mapSize - 1 || y < 1 || y >= mapSize - 1) break;

        float maskValue = maskBuffer[index];
        float localMinHeight = globalMinHeight * maskValue;
        float currentH = heightBuffer[index].height;

        // 마스크 영역은 여전히 퇴적 없이 잘 깎이도록 배율 유지 (용량 20배 뻥튀기)
        float currentCapacity = baseCapacity * (1.0f + maskValue * 20.0f);

        float gx = heightBuffer[index - 1].height - heightBuffer[index + 1].height;
        float gy = heightBuffer[index - mapSize].height - heightBuffer[index + mapSize].height;

        if (sediment > currentCapacity) {
            float depositAmount = (sediment - currentCapacity) * depositSpeed;
            heightBuffer[index].height += depositAmount;
            sediment -= depositAmount;
        } else {
            if (currentH > localMinHeight) {
                float effectiveErodeSpeed = baseErodeSpeed * (maskValue > 0.01f ? maskValue : 0.1f);
                
                float erodeAmount = (currentCapacity - sediment) * effectiveErodeSpeed;
                
                if (currentH - erodeAmount < localMinHeight) {
                    erodeAmount = currentH - localMinHeight;
                }
                
                heightBuffer[index].height -= erodeAmount;
                sediment += erodeAmount;
            }
        }

        if (abs(gx) < 0.001f && abs(gy) < 0.001f) {
             posX += (random(float2(posX, rTime * (i + 1))) - 0.5f);
             posY += (random(float2(posY, rTime * (i + 1))) - 0.5f);
        } else {
             posX += gx; posY += gy;
        }
    }
}